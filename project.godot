; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Processo Seletivo"
config/version="1.0"
run/main_scene="uid://dcjb6iuh210jd"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://d1a1ik4frqstg"

[autoload]

Gerenciador="*uid://5ym4v7qdd4an"

[beautifier]

enable_random_theme=Signal()
default_settings={
"rendering/environment/defaults/default_clear_color": Color(0, 0, 0, 1)
}

[debug]

gdscript/warnings/integer_division=0

[display]

